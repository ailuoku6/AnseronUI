    "run:harmony": "node '../../scripts/anseronui.mjs' run harmony",
    "ios": "node '../../scripts/anseronui.mjs' run ios",
    "android": "node '../../scripts/anseronui.mjs' run android",
    "macos": "node '../../scripts/anseronui.mjs' run macos",
