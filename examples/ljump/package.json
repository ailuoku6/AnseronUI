{
  "name": "ljump",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "setup": "node '../../scripts/anseronui.mjs' setup",
    "check": "node '../../scripts/anseronui.mjs' check",
    "typecheck": "node '../../scripts/anseronui.mjs' typecheck",
    "devtools": "node '../../scripts/anseronui.mjs' devtools",
    "dev:web": "node '../../scripts/anseronui.mjs' dev web",
    "build:web": "node '../../scripts/anseronui.mjs' build web",
    "build:ios": "node '../../scripts/anseronui.mjs' build ios",
