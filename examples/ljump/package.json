    "build:android": "node '../../scripts/anseronui.mjs' build android",
    "build:macos": "node '../../scripts/anseronui.mjs' build macos",
    "build:harmony": "node '../../scripts/anseronui.mjs' build harmony",
    "build:web:release": "node '../../scripts/anseronui.mjs' build web --release",
