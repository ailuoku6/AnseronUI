{
  "name": "@anseronui/example-device",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "ios",
    "android",
    "web",
    "macos"
  ],
  "peerDependencies": {
    "anseronui": "^0.0.1"
  },
  "anseronui": {
    "schemaVersion": 2,
    "typescript": "src/index.ts",
    "ios": {
      "sources": [
        "ios"
      ],
      "factory": "AnseronDevicePlugin",
      "frameworks": [
        "UIKit"
      ]
    },
    "android": {
      "sources": [
        "android"
      ],
      "factory": "org.anseronui.device.DevicePlugin"
    },
    "web": {
      "entry": "web/index.ts"
    },
    "macos": {
      "sources": [
        "macos"
      ],
      "factory": "AnseronMacDevicePlugin",
      "frameworks": [
        "AppKit"
      ]
    }
  }
}
